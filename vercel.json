{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/ingest-results", "schedule": "0 2 * * *" },
    { "path": "/api/retrain",        "schedule": "0 3 * * *" },
    { "path": "/api/calibrate",      "schedule": "0 4 * * *" }
  ]
}
