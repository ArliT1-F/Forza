# ============================================================
#  Forza Soccer Prediction Dashboard – Environment
# ============================================================
# Copy to `.env` for local dev and configure the same values in
# Vercel -> Project Settings -> Environment Variables for prod.
# ============================================================

# ----- Data provider --------------------------------------------------
# Which upstream data source to use. Valid values: "apifootball" (default),
# "sportradar" (stubbed - see /src/providers/sportradar.js).
PROVIDER=apifootball
# Optional client override (Vite-exposed). Usually matches PROVIDER.
VITE_PROVIDER=apifootball

# ----- API-Football (https://www.api-football.com) --------------------
# Server-only. If missing, live calls fail and the UI falls back to mock data.
APIFOOTBALL_KEY=
# Optional explicit demo toggle (useful for previews without quota usage).
FORCE_DEMO_MODE=false
# Client-exposed toggle for local/front-end demo preview.
VITE_FORCE_DEMO_MODE=false

# ----- SportRadar (https://developer.sportradar.com) ------------------
# Leave blank if not using. Only read by the sportradar serverless handler.
SPORTRADAR_KEY=

# ----- Supabase -------------------------------------------------------
# Public URL + anon key are used by the browser. Service-role key is used
# only by serverless /api/* handlers and MUST NEVER ship to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Vite also picks these up at build time for the browser client:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only alias (optional; if set, overrides NEXT_PUBLIC_SUPABASE_URL
# inside serverless functions):
SUPABASE_URL=

# ----- Cron security --------------------------------------------------
# Random long secret. Every cron handler verifies `Authorization: Bearer $CRON_SECRET`
# before doing any work. Vercel Cron sends this header for you automatically.
CRON_SECRET=
